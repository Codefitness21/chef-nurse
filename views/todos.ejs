<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <div class="grocery-list-container">
        <div class="grocery-list">
             <div class="grocery-form">
            <h1>Grocery List</h1>
            <h2>Things left to do: <%= left %></h2>
           
                <form action="/todos/createTodo" method='POST'>
                    <input class="grocery-input" type="text" placeholder="Enter Grocery Item..." name='todoItem'>
                    <input class="submit-btn" type="submit">
                </form>
            </div>
        </div>
        
        <ul>
            <% todos.forEach( el=> { %>
                <li class='todoItem' data-id='<%=el._id%>'>
                    <span class='<%= el.completed === true ? ' completed' : 'not' %>'><%= el.todo %></span>
                    <span class='del'> <img src="/images/trash-can.png" alt="delete trash can" </span>
                </li>
                <% }) %>
        </ul>
    </div>
    <script src="js/main.js"></script>
</body>

</html>