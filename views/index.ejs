<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="recipe-container">
    <div class="search-container">
        <div class="search-field">
            <h1>Recipes</h1>
            <h2>Add Your Favorite Recipes Below: </h2>
            <form action="/todos/createTodo" method='POST'>
                <input class="search-input" type="text" placeholder="Search for recipes..." name="search">
            </form>
            
        </div>
    </div>
   <div class="recipe-book-container">
        <div class="recipe-categories">
            <img class="add-recipe-btn" src="/images/add-recipe-book-btn.png" alt="recipe add icon">
            <h4>New Recipe Book</h4>
        </div>
        
    </div>
     <%- include('books') %>
     <%- include('browser') %>
    </div>
   
</body>
</html>